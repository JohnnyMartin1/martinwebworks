# =============================================================================
# Martin Web Works — environment template
# =============================================================================
# Copy this file to `.env.local` and fill in the values you actually have.
# `.env.local` is git-ignored (see .gitignore). Never commit real secrets.
#
# See EMAIL_SETUP.md for the step-by-step setup of email + DNS.
# =============================================================================

# --- Resend (transactional email provider) -----------------------------------
# Server-only. Used by the Free Audit form to send lead notifications.
# Without this key the form still works in the UI, but no email is sent and
# the server logs a development-only warning.
# Create one at: https://resend.com/api-keys
RESEND_API_KEY=

# --- Email routing -----------------------------------------------------------
# CONTACT_TO_EMAIL: inbox that receives new lead notifications.
# CONTACT_FROM_EMAIL: the sender address that appears on outgoing mail.
#   Must belong to a domain you have verified inside Resend
#   (e.g. team@martinwebworks.com after the martinwebworks.com domain is verified).
CONTACT_TO_EMAIL=team@martinwebworks.com
CONTACT_FROM_EMAIL=team@martinwebworks.com

# --- Scheduling (optional) ---------------------------------------------------
# Public Cal.com / Calendly URL. Must be NEXT_PUBLIC_ prefixed so the value
# is available to both server and client components.
# When empty, /free-audit only shows the form. When set, /free-audit shows
# a "Book a time" option side-by-side with the form.
NEXT_PUBLIC_SCHEDULING_URL=

# --- Analytics (optional, leave empty until ready) ---------------------------
# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX".
# When empty, no analytics script loads and no events are sent. Safe default.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Search Console verification (optional) ---------------------------
# Verification token from Search Console "HTML tag" method.
# When empty, no verification <meta> tag is emitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
